# Copy to .env in the repository root (next to docker-compose.yml). NEVER commit .env.
#   cp .env.docker.example .env
# Generate secrets with:
#   openssl rand -hex 64      (JWT_SECRET)
#   openssl rand -hex 24      (POSTGRES_PASSWORD — hex only, safe inside the DB URL)

JWT_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=postgres
POSTGRES_DB=hr_attendance_db

APP_PORT=8080
CLIENT_URL=http://localhost:8080
APP_TIMEZONE=Africa/Cairo
JWT_EXPIRES_IN=7d

# Automatic absence marking (on/off)
ABSENCE_JOB=on
# Apply pending Prisma migrations at start (prisma migrate deploy)
DB_MIGRATE=true
# First install only: create roles, demo users and data. Set back to false afterwards.
RUN_SEED=false
# Required when RUN_SEED=true: the first SUPER_ADMIN account (min. 12 characters).
# The seed never creates demo users in Docker (NODE_ENV=production).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Network exposure ---
# 0.0.0.0 = reachable from other devices on the network (LAN use).
# 127.0.0.1 = only through HTTPS (Caddy) or a tunnel — use this on a VPS.
APP_BIND=0.0.0.0
# HTTPS without a domain (profile "https"): your public IP with dashes + .sslip.io
# e.g. SITE_ADDRESS=203-0-113-10.sslip.io   then CLIENT_URL=https://203-0-113-10.sslip.io
SITE_ADDRESS=

# --- API protection ---
# Reverse proxies in front of the backend: 1 = nginx only (default), 2 = with the Caddy https profile.
TRUST_PROXY=1
# Failed logins allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10
