# Copy this file to .env and fill in real values. NEVER commit .env
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hr_attendance_db?schema=public"
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
PORT=5000
CLIENT_URL="http://localhost:5173"

# --- Seed (node src/seed.js) ---
# First SUPER_ADMIN account. Required by the seed; password min. 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
# Development only: also create demo users (admin@company.com / employee@company.com),
# 25 sample employees and sample attendance. Ignored when NODE_ENV=production.
SEED_DEMO=false
# Password for every demo account (default: Demo@12345)
# DEMO_PASSWORD=""
