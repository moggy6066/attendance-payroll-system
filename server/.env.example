# Copy this file to .env and fill in real values. NEVER commit .env
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hr_attendance_db?schema=public"
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
PORT=5000
CLIENT_URL="http://localhost:5173"
